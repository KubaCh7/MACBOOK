// Skopiuj do Secrets.xcconfig (ten plik jest w .gitignore).
// UWAGA: bez "https://" — w plikach .xcconfig "//" zaczyna komentarz.
SUPABASE_HOST = TWOJ-PROJEKT.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_...
// Unikalny prefiks, np. com.twojeimie — musi być inny niż u kogokolwiek.
BUNDLE_ID_PREFIX = com.twojeimie
